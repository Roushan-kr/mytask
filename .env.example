# Authentication Credentials (Constant-Time Checked)
AUTH_EMAIL="admin@taskflow.local"
AUTH_PASSWORD="admin_password_123"
AUTH_SECRET="taskflow_super_secret_jwt_key_2026_min_32_characters!"

# MongoDB Database Connection
MONGODB_URI="mongodb://127.0.0.1:27017/taskflow"

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BA_your_generated_public_vapid_key_here"
VAPID_PRIVATE_KEY="your_generated_private_vapid_key_here"
VAPID_SUBJECT="mailto:admin@taskflow.local"

# Vercel Serverless Cron Secret (For GitHub Actions / Cron triggers)
CRON_SECRET="taskflow_cron_secret_token_secure_2026"

# Model Context Protocol (MCP) API Token for AI Agent Access (Claude/Cursor/Raycast)
MCP_API_KEY="taskflow_mcp_secure_api_key_2026_min_32_characters!"

# Optional: Docker Standalone Build (leave unset or false for Vercel/local dev)
DOCKER_BUILD=false